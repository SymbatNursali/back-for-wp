generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  pending
  processed
  failed
}

enum MatchState {
  unmatched
  partial
  matched
  rejected
}

enum IngestSource {
  webhook
  api
  csv_import
  retry_job
}

model Session {
  id          BigInt   @id @default(autoincrement())
  sessionId   String   @unique @map("session_id") @db.VarChar(128)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  leads        Lead[]
  ingestEvents IngestEvent[]

  @@index([createdAt], map: "idx_sessions_created_at")
  @@map("sessions")
}

model Lead {
  id          BigInt     @id @default(autoincrement())
  sessionId   BigInt     @map("session_id")
  leadToken   String     @unique @map("lead_token") @db.VarChar(128)
  fbclid      String?    @unique @db.VarChar(255)
  status      EventStatus
  matchState  MatchState @default(unmatched) @map("match_state")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId], map: "idx_leads_session_id")
  @@index([status], map: "idx_leads_status")
  @@index([createdAt], map: "idx_leads_created_at")
  @@index([matchState], map: "idx_leads_match_state")
  @@map("leads")
}

model WaChat {
  id          BigInt   @id @default(autoincrement())
  waChatId    String   @unique @map("wa_chat_id") @db.VarChar(128)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  messages WaMessage[]

  @@index([createdAt], map: "idx_wa_chats_created_at")
  @@map("wa_chats")
}

model WaMessage {
  id           BigInt   @id @default(autoincrement())
  waChatRefId  BigInt   @map("wa_chat_ref_id")
  waMessageId  String   @unique @map("wa_message_id") @db.VarChar(128)
  eventId      String   @map("event_id") @db.VarChar(128)
  status       EventStatus
  dedupeKey    String   @unique @map("dedupe_key") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  chat WaChat @relation(fields: [waChatRefId], references: [id], onDelete: Restrict)

  @@index([eventId], map: "idx_wa_messages_event_id")
  @@index([status], map: "idx_wa_messages_status")
  @@index([createdAt], map: "idx_wa_messages_created_at")
  @@map("wa_messages")
}

model IngestEvent {
  id          BigInt       @id @default(autoincrement())
  sessionId   BigInt       @map("session_id")
  source      IngestSource
  dedupeKey   String       @unique @map("dedupe_key") @db.VarChar(255)
  payload     Json
  status      EventStatus
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId], map: "idx_ingest_events_session_id")
  @@index([status], map: "idx_ingest_events_status")
  @@index([createdAt], map: "idx_ingest_events_created_at")
  @@map("ingest_events")
}

model MetaEvent {
  id          BigInt   @id @default(autoincrement())
  leadId      BigInt?  @map("lead_id")
  eventId     String   @map("event_id") @db.VarChar(128)
  dedupeKey   String   @unique @map("dedupe_key") @db.VarChar(255)
  payload     Json
  status      EventStatus
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([eventId], map: "idx_meta_events_event_id")
  @@index([status], map: "idx_meta_events_status")
  @@index([createdAt], map: "idx_meta_events_created_at")
  @@map("meta_events")
}

model AdminUser {
  id           BigInt   @id @default(autoincrement())
  email        String   @unique @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(255)
  role         String   @db.VarChar(64)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt], map: "idx_admin_users_created_at")
  @@map("admin_users")
}

model StatusDictionary {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(64)
  title       String   @db.VarChar(128)
  description String?  @db.VarChar(255)
  isTerminal  Boolean  @default(false) @map("is_terminal")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  labelMappings LabelMapping[]

  @@index([createdAt], map: "idx_status_dictionary_created_at")
  @@map("status_dictionary")
}

model LabelMapping {
  id               BigInt @id @default(autoincrement())
  externalLabel    String @map("external_label") @db.VarChar(128)
  internalStatusId Int    @map("internal_status_id")

  internalStatus StatusDictionary @relation(fields: [internalStatusId], references: [id], onDelete: Restrict)

  @@unique([externalLabel, internalStatusId], map: "uq_label_mappings_external_internal")
  @@map("label_mappings")
}
